{
   "compilerOptions": {
      "ignoreDeprecations": "6.0",
      "baseUrl": ".",
      "outDir": "./dist",
      "rootDir": "../",
      "module": "commonjs",
      "target": "es2016",
      "types": [],
      "sourceMap": true,
      "declaration": true,
      "declarationMap": true,
      "noUncheckedIndexedAccess": true,
      "exactOptionalPropertyTypes": true,
      "strict": true,
      "jsx": "react-jsx",
      "verbatimModuleSyntax": false,
      "isolatedModules": true,
      "noUncheckedSideEffectImports": true,
      "moduleDetection": "force",
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "paths": {
         // app
         "@app/*": ["src/app/*"],

         // infra
         "@embeddings/*": ["src/infra/embeddings/*"],         
         "@ollama/*": ["src/infra/ollama/*"],
         "@storage/*": ["src/infra/storage/*"],

         // modules
         "@ai/*": ["src/modules/ai/*"],
         "@analysis/*": ["src/modules/analysis/*"],
         "@document/*": ["src/modules/document/*"],
         "@project/*": ["src/modules/project/*"],
         "@rag/*": ["src/modules/rag/*"],
         "@user/*": ["src/modules/user/*"],

         // shared
         "@config/*": ["src/shared/config/*"],
         "@database/*": ["src/shared/database/*"],
         "@errors/*": ["src/shared/errors/*"],
         "@typesGlobal/*": ["src/shared/types/*"],
         "@utils/*": ["src/shared/utils/*"],

         // root
         "@root/*": ["src/*"]
      }
   }
}
